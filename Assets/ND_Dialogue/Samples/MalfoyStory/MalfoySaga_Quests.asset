  m_Script: {fileID: 11500000, guid: ee743a5f8fa433949a2e4b98be42ccc3, type: 3}
  m_Name: MalfoySaga_Quests
  m_EditorClassIdentifier: ND.Quests::ND.Quests.QuestDatabase
  quests:
  - name: malfoy_saga
    title:
      m_EntryId: 0
      m_Table: {fileID: 0}
      m_Text: The Malfoy Saga
    initialState: 1
    description: 
    summary:
      m_EntryId: 0
      m_Table: {fileID: 0}
      m_Text: From a shop in Diagon Alley to a very awkward morning. Find Malfoy
        where the story continues (look for the "!").
    group: Main
    trackWhenActive: 1
    goal: 0
    progression:
      rid: -2
    completeAtGoal: 1
    steps:
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: 'Diagon Alley: meet the girl at Madam Malkin''s'
      visibleWhen:
      - rid: 3058894650176962865
      doneWhen:
      - rid: 3058894650176962866
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: 'Quidditch Pitch: the first flying lesson'
      visibleWhen:
      - rid: 3058894650176962867
      doneWhen:
      - rid: 3058894650176962868
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: 'Forbidden Forest: detention, at night'
      visibleWhen:
      - rid: 3058894650176962869
      doneWhen:
      - rid: 3058894650176962870
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: 'Library: someone wants to study with you'
      visibleWhen:
      - rid: 3058894650176962871
      doneWhen:
      - rid: 3058894650176962872
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: 'The Yule Ball: find a partner (see its quest)'
      visibleWhen:
      - rid: 3058894650176962873
      doneWhen:
      - rid: 3058894650176962874
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: 'Hogsmeade: read the Daily Prophet'
      visibleWhen:
      - rid: 3058894650176962875
      doneWhen:
      - rid: 3058894650176962876
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: 'Years later, Malfoy Manor: knock on her door'
      visibleWhen:
      - rid: 3058894650176962877
      doneWhen:
      - rid: 3058894650176962878
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: 'Malfoy Manor: the morning after'
      visibleWhen:
      - rid: 3058894650176962879
      doneWhen:
      - rid: 3058894650176962880
  - name: yule_ball
    title:
      m_EntryId: 0
      m_Table: {fileID: 0}
      m_Text: A Partner for the Yule Ball
    initialState: 0
    description: 
    summary:
      m_EntryId: 0
      m_Table: {fileID: 0}
      m_Text: Everyone is pairing up for the Yule Ball. You asked Malfoy. Of course
        she said no. ...Didn't she?
    group: Main
    trackWhenActive: 1
    goal: 0
    progression:
      rid: -2
    completeAtGoal: 1
    steps:
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: Ask Malfoy to the Yule Ball
      visibleWhen: []
      doneWhen:
      - rid: 3058894650176962881
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: Answer the paper crane
      visibleWhen:
      - rid: 3058894650176962882
      doneWhen:
      - rid: 3058894650176962883
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: Make it up to her (the ferret incident)
      visibleWhen:
      - rid: 3058894650176962884
      doneWhen:
      - rid: 3058894650176962885
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: Meet her at the Great Hall
      visibleWhen:
      - rid: 3058894650176962886
      doneWhen:
      - rid: 3058894650176962887
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: Share the dance
      visibleWhen:
      - rid: 3058894650176962888
      doneWhen: []
  - name: chocolate_frog
    title:
      m_EntryId: 0
      m_Table: {fileID: 0}
      m_Text: A Frog Before the Match
    initialState: 0
    description: 
    summary:
      m_EntryId: 0
      m_Table: {fileID: 0}
      m_Text: Someone slipped a Chocolate Frog into your bag before the Quidditch
        match.
    group: Side
    trackWhenActive: 1
    goal: 0
    progression:
      rid: -2
    completeAtGoal: 1
    steps:
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: Find out who left it
      visibleWhen: []
      doneWhen:
      - rid: 3058894650176962889
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: Decide what to do with it
      visibleWhen:
      - rid: 3058894650176962890
      doneWhen: []
