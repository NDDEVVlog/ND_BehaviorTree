    - rid: 3058894627830235243
      type: {class: DialogueEntry, ns: ND.Dialogue, asm: ND.Dialogue}
      data:
        id: 1
        title: 
        actorId: 362182703
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: Hi! Are you going to Hogwarts too?
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: Happy
        moreLines: []
        isPassthrough: 0
        conditions: []
        actions: []
        links:
        - conversationId: 1
          entryId: 2
          priority: 2
          conditions: []
        position: {x: 300, y: 0}
    - rid: 3058894627830235244
      type: {class: DialogueEntry, ns: ND.Dialogue, asm: ND.Dialogue}
      data:
        id: 2
        title: 
        actorId: 282886598
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: Oh? Yeah... I think so.
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: Surprised
        moreLines: []
        isPassthrough: 0
        conditions: []
        actions: []
        links:
        - conversationId: 1
          entryId: 3
          priority: 2
          conditions: []
        position: {x: 600, y: 0}
    - rid: 3058894627830235245
      type: {class: DialogueEntry, ns: ND.Dialogue, asm: ND.Dialogue}
      data:
        id: 3
        title: 
        actorId: 362182703
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: Oh, good! Have you ever flown on a broom? I do it all the time!
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: Happy
        moreLines:
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: First years aren't allowed their own brooms, apparently. But
              I'm going to sneak one in anyway!
          emotion: Smug
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: Oh, do you like Quidditch? Which house do you think you'll be
              in?
          emotion: 
        isPassthrough: 0
        conditions: []
        actions: []
        links:
        - conversationId: 1
          entryId: 4
          priority: 2
          conditions: []
        - conversationId: 1
          entryId: 5
          priority: 2
          conditions: []
        position: {x: 900, y: 0}
    - rid: 3058894627830235246
      type: {class: DialogueEntry, ns: ND.Dialogue, asm: ND.Dialogue}
      data:
        id: 4
        title: 
        actorId: 282886598
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: Er... I'm not really sure yet.
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: Neutral
        moreLines: []
        isPassthrough: 0
        conditions: []
        actions: []
        links:
        - conversationId: 1
          entryId: 7
          priority: 2
          conditions: []
        position: {x: 1200, y: 0}
    - rid: 3058894627830235247
      type: {class: DialogueEntry, ns: ND.Dialogue, asm: ND.Dialogue}
      data:
        id: 5
        title: 
        actorId: 282886598
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: Gryffindor, maybe?
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: Happy
        moreLines: []
        isPassthrough: 0
        conditions: []
        actions: []
        links:
        - conversationId: 1
          entryId: 6
          priority: 2
          conditions: []
        position: {x: 1200, y: 190}
    - rid: 3058894627830235248
      type: {class: DialogueEntry, ns: ND.Dialogue, asm: ND.Dialogue}
      data:
        id: 6
        title: 
        actorId: 362182703
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: Gryffindor? Ugh. All courage and no brains.
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: Pout
        moreLines:
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: You'll grow out of it.
          emotion: Smug
        isPassthrough: 0
        conditions: []
        actions: []
        links:
        - conversationId: 1
          entryId: 7
          priority: 2
          conditions: []
        position: {x: 1500, y: 190}
    - rid: 3058894627830235249
      type: {class: DialogueEntry, ns: ND.Dialogue, asm: ND.Dialogue}
      data:
        id: 7
        title: 
        actorId: 362182703
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: I'm definitely going to Slytherin! My whole family's been in it!
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: Happy
        moreLines:
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: If I end up somewhere like Hufflepuff, I'll bite my tongue off!!
          emotion: 
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: You should be in Slytherin too! Don't go mixing with the wrong
              sort! Especially...
          emotion: 
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: ...What's that? He looks like a savage.
          emotion: Angry
        isPassthrough: 0
        conditions: []
        actions: []
        links:
        - conversationId: 1
          entryId: 8
          priority: 2
          conditions: []
        - conversationId: 1
          entryId: 9
          priority: 2
          conditions: []
        position: {x: 1800, y: 0}
    - rid: 3058894627830235250
      type: {class: DialogueEntry, ns: ND.Dialogue, asm: ND.Dialogue}
      data:
        id: 8
        title: 
        actorId: 282886598
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: That's Hagrid. He's my friend.
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: Angry
        moreLines: []
        isPassthrough: 0
        conditions: []
        actions:
        - rid: 3058894627830235331
        links:
        - conversationId: 1
          entryId: 10
          priority: 2
          conditions: []
        position: {x: 2100, y: 0}
    - rid: 3058894627830235251
      type: {class: DialogueEntry, ns: ND.Dialogue, asm: ND.Dialogue}
      data:
        id: 9
        title: 
        actorId: 282886598
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: (Say nothing.)
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: Neutral
        moreLines: []
        isPassthrough: 0
        conditions: []
        actions: []
        links:
        - conversationId: 1
          entryId: 10
          priority: 2
          conditions: []
        position: {x: 2100, y: 190}
    - rid: 3058894627830235252
      type: {class: DialogueEntry, ns: ND.Dialogue, asm: ND.Dialogue}
      data:
        id: 10
        title: 
        actorId: 362182703
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: Your FRIEND?
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: Surprised
        moreLines:
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: ...Hmph. Suit yourself.
          emotion: Pout
        isPassthrough: 0
        conditions: []
        actions: []
        links:
        - conversationId: 1
          entryId: 11
          priority: 2
          conditions: []
        position: {x: 2400, y: 0}
    - rid: 3058894627830235253
      type: {class: DialogueEntry, ns: ND.Dialogue, asm: ND.Dialogue}
      data:
        id: 11
        title: Great Hall, after the Sorting
        actorId: 282886598
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
