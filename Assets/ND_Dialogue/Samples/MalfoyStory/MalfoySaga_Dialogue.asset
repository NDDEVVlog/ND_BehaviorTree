        actorId: 433743447
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: '(A paper crane lands on your desk: "How about me as a dance partner?")'
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
