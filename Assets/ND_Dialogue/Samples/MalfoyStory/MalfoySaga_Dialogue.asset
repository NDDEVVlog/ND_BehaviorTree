          voice: {fileID: 0}
          localizedVoice:
            m_EntryId: 0
            m_Table: {fileID: 0}
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: Guess we were never going to be just "friends", were we?
          emotion: Happy
          voice: {fileID: 0}
          localizedVoice:
            m_EntryId: 0
            m_Table: {fileID: 0}
        isPassthrough: 0
