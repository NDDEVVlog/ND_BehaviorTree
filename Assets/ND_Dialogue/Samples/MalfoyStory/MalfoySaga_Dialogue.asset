        title: 
        actorId: 456567859
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: Having trouble sleeping? Then perhaps I should tell you a story.
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: 
        voice: {fileID: 0}
        localizedVoice:
          m_EntryId: 0
