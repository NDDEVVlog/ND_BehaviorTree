        id: 14
        title: 
        actorId: 507349979
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: STOP READING IT OUT LOUD!!
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: Embarrassed
        voice: {fileID: 0}
        localizedVoice:
          m_EntryId: 0
