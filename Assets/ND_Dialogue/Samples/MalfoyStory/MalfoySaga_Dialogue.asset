      data:
        id: 1
        title: the crane
        actorId: 507349979
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: '(A paper crane lands on your desk: "How about me as a dance partner?")'
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: Neutral
        voice: {fileID: 0}
        localizedVoice:
          m_EntryId: 0
          m_Table: {fileID: 0}
        moreLines:
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: ...Well? What do you think?
          emotion: Pout
          voice: {fileID: 0}
          localizedVoice:
            m_EntryId: 0
            m_Table: {fileID: 0}
        isPassthrough: 0
        sequence: 
        isHub: 0
