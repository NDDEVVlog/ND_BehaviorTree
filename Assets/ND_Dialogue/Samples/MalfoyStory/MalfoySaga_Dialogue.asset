        id: 6
        title: 
        actorId: 349341134
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: EEEEEEK!!!! P-POTTER?!
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: Scared
        voice: {fileID: 0}
        localizedVoice:
          m_EntryId: 0
          m_Table: {fileID: 0}
        voiceCue:
          rid: -2
        moreLines:
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: I wasn't practising! I was... inspecting the broom!
          emotion: Embarrassed
          voice: {fileID: 0}
          localizedVoice:
            m_EntryId: 0
            m_Table: {fileID: 0}
          voiceCue:
            rid: -2
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: ...Fine. Show me. Just once. And if you laugh, I'll hex you.
          emotion: Pout
          voice: {fileID: 0}
          localizedVoice:
            m_EntryId: 0
            m_Table: {fileID: 0}
          voiceCue:
            rid: -2
