          m_Table: {fileID: 0}
        moreLines:
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: It was somewhere in the jungles of East Asia. A quiet night,
              much like this one.
          emotion: 
          voice: {fileID: 0}
          localizedVoice:
            m_EntryId: 0
            m_Table: {fileID: 0}
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: It was a forest when I arrived. By the time I left, it was a
              runway.
          emotion: 
          voice: {fileID: 0}
          localizedVoice:
            m_EntryId: 0
            m_Table: {fileID: 0}
        isPassthrough: 0
        sequence: 
        isHub: 0
