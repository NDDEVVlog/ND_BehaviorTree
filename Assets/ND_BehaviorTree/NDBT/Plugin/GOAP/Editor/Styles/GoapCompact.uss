/* GOAP "Compact" look (GoapAppearancePack → GoapActionCompactView). Layered over the default node style. */
.goap-compact > .node-border {
    border-radius: 16px;
    min-width: 150px;
}

.goap-compact > .node-border > .main-container {
    border-radius: 14px;
}

.goap-compact > .node-border > .main-container > .title {
    padding: 3px 8px;
}

.goap-compact > .node-border > .main-container > .title > .icon-image {
    width: 16px;
    height: 16px;
    margin-right: 5px;
}

.goap-compact > .node-border > .main-container > .title > #title-content-container > .title-textfield {
    font-size: 12px;
}

.goap-compact > .node-border > .main-container > .title > #title-content-container > .type-label {
    display: none;
}

.goap-compact .goap-panel {
    min-width: 150px;
}

.goap-compact-toggle {
    width: 18px;
    height: 18px;
    margin: 0 0 0 4px;
    padding: 0;
    font-size: 10px;
    border-radius: 9px;
}

/* One-line summary shown while collapsed; Live Debug colours it by the preconditions */
.goap-digest {
    font-size: 10px;
    color: #A8B0BD;
    margin: 0;
    padding: 0 10px 5px 10px;
}

.goap-digest--met {
    color: #6FD474;
}

.goap-digest--unmet {
    color: #FF7B7B;
}
