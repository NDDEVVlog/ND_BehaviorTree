    - rid: 3058894633377727312
      type: {class: DialogueEntry, ns: ND.Dialogue, asm: ND.Dialogue}
      data:
        id: 11
        title: 
        actorId: 488088358
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: Having trouble sleeping? Then perhaps I should tell you a story.
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: 
        voice: {fileID: 0}
        localizedVoice:
          m_EntryId: 0
          m_Table: {fileID: 0}
        moreLines:
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: It was somewhere in the jungles of East Asia. A quiet night,
              much like this one.
          emotion: 
          voice: {fileID: 0}
          localizedVoice:
            m_EntryId: 0
            m_Table: {fileID: 0}
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: It was a forest when I arrived. By the time I left, it was a
              runway.
          emotion: 
          voice: {fileID: 0}
          localizedVoice:
            m_EntryId: 0
            m_Table: {fileID: 0}
        isPassthrough: 0
        sequence: 
        isHub: 0
        conditions: []
        actions:
        - rid: 3058894633377727458
        links: []
        position: {x: 3000, y: 190}
