      text:
        m_EntryId: 1
        m_Table: {fileID: 11400000, guid: 3437088a64de1324cb37df6a0db84d6b, type: 2}
        m_Text: Halt! Nobody passes this gate.
      menuText:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: 
      emotion: 
      isPassthrough: 0
      conditions:
      - rid: 3058894610877645043
      - rid: 3058894610877645044
      actions:
      - rid: 3058894610877645045
      links:
      - conversationId: 1
        entryId: 3
        priority: 2
        conditions: []
      - conversationId: 1
        entryId: 4
        priority: 2
        conditions: []
      position: {x: 300, y: 0}
    - id: 2
      title: 
      actorId: 2
      text:
        m_EntryId: 2
        m_Table: {fileID: 11400000, guid: 3437088a64de1324cb37df6a0db84d6b, type: 2}
        m_Text: You again. Looking for work or not?
      menuText:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: 
      emotion: 
      isPassthrough: 0
      conditions:
      - rid: 3058894610877645046
      - rid: 3058894610877645047
      actions: []
      links:
      - conversationId: 1
        entryId: 3
        priority: 2
        conditions: []
      - conversationId: 1
        entryId: 4
        priority: 2
        conditions: []
      position: {x: 300, y: 130}
    - id: 3
      title: 
      actorId: 1
      text:
        m_EntryId: 3
        m_Table: {fileID: 11400000, guid: 3437088a64de1324cb37df6a0db84d6b, type: 2}
        m_Text: I'm looking for work.
      menuText:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: 
      emotion: 
      isPassthrough: 0
      conditions: []
      actions: []
      links:
      - conversationId: 1
        entryId: 5
        priority: 2
        conditions: []
      position: {x: 620, y: 0}
    - id: 4
      title: 
      actorId: 1
      text:
        m_EntryId: 4
        m_Table: {fileID: 11400000, guid: 3437088a64de1324cb37df6a0db84d6b, type: 2}
        m_Text: Out of my way!
      menuText:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: 
      emotion: 
      isPassthrough: 0
      conditions: []
      actions: []
      links:
      - conversationId: 1
        entryId: 6
        priority: 2
        conditions: []
      position: {x: 620, y: 130}
    - id: 5
      title: 
      actorId: 2
      text:
        m_EntryId: 5
        m_Table: {fileID: 11400000, guid: 3437088a64de1324cb37df6a0db84d6b, type: 2}
        m_Text: Find my old key in the market and I'll let you through.
      menuText:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: 
      emotion: 
      isPassthrough: 0
      conditions: []
      actions:
      - rid: 3058894610877645048
      - rid: 3058894610877645049
      links: []
      position: {x: 940, y: 0}
    - id: 6
      title: 
      actorId: 2
      text:
        m_EntryId: 6
        m_Table: {fileID: 11400000, guid: 3437088a64de1324cb37df6a0db84d6b, type: 2}
        m_Text: Watch your tone, stranger.
      menuText:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: 
      emotion: Angry
      isPassthrough: 0
      conditions: []
      actions:
      - rid: 3058894610877645050
      - rid: 3058894610877645051
      links: []
      position: {x: 940, y: 130}
    - id: 7
      title: 
      actorId: 2
      text:
        m_EntryId: 7
        m_Table: {fileID: 11400000, guid: 3437088a64de1324cb37df6a0db84d6b, type: 2}
        m_Text: Still no key? Try the merchant.
      menuText:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: 
      emotion: 
      isPassthrough: 0
      conditions:
      - rid: 3058894610877645052
      actions: []
      links: []
      position: {x: 300, y: 300}
    - id: 8
      title: 
      actorId: 2
      text:
        m_EntryId: 8
        m_Table: {fileID: 11400000, guid: 3437088a64de1324cb37df6a0db84d6b, type: 2}
        m_Text: My key! Thank you. The gate is yours.
      menuText:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: 
      emotion: Happy
      isPassthrough: 0
      conditions:
      - rid: 3058894610877645053
      - rid: 3058894610877645054
