        id: 6
        title: 
        actorId: 507349979
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: W-well, obviously. Who else would put up with your dancing?
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
