    - rid: 3058894627830235254
      type: {class: DialogueEntry, ns: ND.Dialogue, asm: ND.Dialogue}
      data:
        id: 12
        title: 
        actorId: 362182703
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: ...You again, Potter? Don't think I'll be nice twice.
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: Pout
        moreLines:
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: Well? Go on, then. The Great Hall is that way.
          emotion: Smug
        isPassthrough: 0
        conditions: []
        actions: []
        links:
        - conversationId: 1
          entryId: 11
          priority: 2
          conditions: []
        position: {x: 300, y: 380}
    - rid: 3058894627830235255
      type: {class: DialogueEntry, ns: ND.Dialogue, asm: ND.Dialogue}
      data:
        id: 13
        title: 
        actorId: 362182703
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: You're Harry Potter?!
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: Surprised
        moreLines:
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: Why are you hanging around with those idiots? I'll help you find
              better friends!
          emotion: Smug
        isPassthrough: 0
        conditions: []
        actions: []
        links:
        - conversationId: 1
          entryId: 14
          priority: 2
          conditions: []
        - conversationId: 1
          entryId: 15
          priority: 2
          conditions: []
        position: {x: 3000, y: 0}
    - rid: 3058894627830235256
      type: {class: DialogueEntry, ns: ND.Dialogue, asm: ND.Dialogue}
      data:
        id: 14
        title: 
        actorId: 282886598
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: I can choose my own friends.
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: Slap her hand away
        emotion: Angry
        moreLines: []
        isPassthrough: 0
        conditions: []
        actions:
        - rid: 3058894627830235332
        links:
        - conversationId: 1
          entryId: 16
          priority: 2
          conditions: []
        position: {x: 3300, y: 0}
    - rid: 3058894627830235257
      type: {class: DialogueEntry, ns: ND.Dialogue, asm: ND.Dialogue}
      data:
        id: 15
        title: 
        actorId: 282886598
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: ...Fine. But Ron and Hermione aren't idiots.
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: Shake her hand
        emotion: Neutral
        moreLines: []
        isPassthrough: 0
        conditions: []
        actions:
        - rid: 3058894627830235333
        links:
        - conversationId: 1
          entryId: 17
          priority: 2
          conditions: []
        position: {x: 3300, y: 190}
    - rid: 3058894627830235258
      type: {class: DialogueEntry, ns: ND.Dialogue, asm: ND.Dialogue}
      data:
        id: 16
        title: 
        actorId: 362182703
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: Huh...?
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: Sad
        moreLines:
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: You...
          emotion: 
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: Y-you'll regret this!!!!
          emotion: Embarrassed
        isPassthrough: 0
        conditions: []
        actions: []
        links: []
        position: {x: 3600, y: 0}
    - rid: 3058894627830235259
      type: {class: DialogueEntry, ns: ND.Dialogue, asm: ND.Dialogue}
      data:
        id: 17
        title: 
        actorId: 362182703
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: '!!'
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: Surprised
        moreLines:
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: I-it's not like I wanted to shake your hand or anything!
          emotion: Embarrassed
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: ...Your hand is warm. That's disgusting. Hmph.
          emotion: Pout
        isPassthrough: 0
