        id: 3
        title: 
        actorId: 349341134
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: Oh, good! Have you ever flown on a broom? I do it all the time!
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: Happy
        voice: {fileID: 0}
        localizedVoice:
          m_EntryId: 0
          m_Table: {fileID: 0}
        voiceCue:
          rid: -2
        moreLines:
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: First years aren't allowed their own brooms, apparently. But
              I'm going to sneak one in anyway!
          emotion: Smug
          voice: {fileID: 0}
          localizedVoice:
            m_EntryId: 0
            m_Table: {fileID: 0}
          voiceCue:
            rid: -2
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: Oh, do you like Quidditch? Which house do you think you'll be
              in?
          emotion: 
          voice: {fileID: 0}
          localizedVoice:
            m_EntryId: 0
            m_Table: {fileID: 0}
          voiceCue:
            rid: -2
