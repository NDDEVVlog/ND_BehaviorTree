        id: 16
        title: 
        actorId: 507349979
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: Ideal man? Him? I'd rather kiss a Blast-Ended Skrewt.
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: Angry
        voice: {fileID: 0}
        localizedVoice:
          m_EntryId: 0
          m_Table: {fileID: 0}
        moreLines:
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: I hate you, Potter. Every word in that paper is a lie, and so
              are you.
          emotion: 
          voice: {fileID: 0}
          localizedVoice:
            m_EntryId: 0
            m_Table: {fileID: 0}
        isPassthrough: 0
        sequence: 
        isHub: 0
