  m_Script: {fileID: 11500000, guid: ee743a5f8fa433949a2e4b98be42ccc3, type: 3}
  m_Name: MalfoySaga_Quests
  m_EditorClassIdentifier: ND.Quests::ND.Quests.QuestDatabase
  quests:
  - name: malfoy_saga
    title:
      m_EntryId: 0
      m_Table: {fileID: 0}
      m_Text: The Malfoy Saga
    initialState: 1
    description: 
    summary:
      m_EntryId: 0
      m_Table: {fileID: 0}
      m_Text: From a shop in Diagon Alley to a very awkward morning. Find Malfoy
        where the story continues (look for the "!").
    group: Main
    trackWhenActive: 1
    goal: 0
    progression:
      rid: -2
    completeAtGoal: 1
    steps:
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: 'Diagon Alley: meet the girl at Madam Malkin''s'
      visibleWhen:
      - rid: 3058894633377727253
      doneWhen:
      - rid: 3058894633377727254
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: 'Quidditch Pitch: the first flying lesson'
      visibleWhen:
      - rid: 3058894633377727255
      doneWhen:
      - rid: 3058894633377727256
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: 'Forbidden Forest: detention, at night'
      visibleWhen:
      - rid: 3058894633377727257
      doneWhen:
      - rid: 3058894633377727258
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: 'Library: someone wants to study with you'
      visibleWhen:
      - rid: 3058894633377727259
      doneWhen:
      - rid: 3058894633377727260
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: 'The Yule Ball: find a partner (see its quest)'
      visibleWhen:
      - rid: 3058894633377727261
      doneWhen:
      - rid: 3058894633377727262
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: 'Hogsmeade: read the Daily Prophet'
      visibleWhen:
      - rid: 3058894633377727263
      doneWhen:
      - rid: 3058894633377727264
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: 'Years later, Malfoy Manor: knock on her door'
      visibleWhen:
      - rid: 3058894633377727265
      doneWhen:
      - rid: 3058894633377727266
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: 'Malfoy Manor: the morning after'
      visibleWhen:
      - rid: 3058894633377727267
      doneWhen:
      - rid: 3058894633377727268
  - name: yule_ball
    title:
      m_EntryId: 0
      m_Table: {fileID: 0}
      m_Text: A Partner for the Yule Ball
    initialState: 0
    description: 
    summary:
      m_EntryId: 0
      m_Table: {fileID: 0}
      m_Text: Everyone is pairing up for the Yule Ball. You asked Malfoy. Of course
        she said no. ...Didn't she?
    group: Main
    trackWhenActive: 1
    goal: 0
    progression:
      rid: -2
    completeAtGoal: 1
    steps:
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: Ask Malfoy to the Yule Ball
      visibleWhen: []
      doneWhen:
      - rid: 3058894633377727269
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: Answer the paper crane
      visibleWhen:
      - rid: 3058894633377727270
      doneWhen:
      - rid: 3058894633377727271
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: Make it up to her (the ferret incident)
      visibleWhen:
      - rid: 3058894633377727272
      doneWhen:
      - rid: 3058894633377727273
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: Meet her at the Great Hall
      visibleWhen:
      - rid: 3058894633377727274
      doneWhen:
      - rid: 3058894633377727275
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: Share the dance
      visibleWhen:
      - rid: 3058894633377727276
      doneWhen: []
  - name: chocolate_frog
    title:
      m_EntryId: 0
      m_Table: {fileID: 0}
      m_Text: A Frog Before the Match
    initialState: 0
    description: 
    summary:
      m_EntryId: 0
      m_Table: {fileID: 0}
      m_Text: Someone slipped a Chocolate Frog into your bag before the Quidditch
        match.
    group: Side
    trackWhenActive: 1
    goal: 0
    progression:
      rid: -2
    completeAtGoal: 1
    steps:
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: Find out who left it
      visibleWhen: []
      doneWhen:
      - rid: 3058894633377727277
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: Decide what to do with it
      visibleWhen:
      - rid: 3058894633377727278
      doneWhen: []
