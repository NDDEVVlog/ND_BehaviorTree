        actorId: 349341134
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: ...You again, Potter? Don't think I'll be nice twice.
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: Pout
        voice: {fileID: 0}
        localizedVoice:
