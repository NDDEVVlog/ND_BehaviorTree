        id: 6
        title: 
        actorId: 349341134
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: Gryffindor? Ugh. All courage and no brains.
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: Pout
        voice: {fileID: 0}
        localizedVoice:
          m_EntryId: 0
          m_Table: {fileID: 0}
        voiceCue:
          rid: -2
        moreLines:
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: You'll grow out of it.
          emotion: Smug
          voice: {fileID: 0}
          localizedVoice:
            m_EntryId: 0
            m_Table: {fileID: 0}
          voiceCue:
            rid: -2
        isPassthrough: 0
