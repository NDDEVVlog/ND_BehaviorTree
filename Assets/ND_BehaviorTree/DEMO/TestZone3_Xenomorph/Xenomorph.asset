  notes:
  - id: 82b2d227-3cee-4cb0-a801-dee028d78a6c
    title: 'Xenomorph (Alien: Isolation style)'
    content: 'XenoDirector (scene) knows where the player is but only gives a fuzzy
      hint, a menace gauge and learned values. This tree decides from its senses.

      Reactive
      Selector: left = highest priority, re-checked every tick.

      Sub-nodes
      keep it compact: Check = gate, Set Bool On Finish = clear the flag, Agent Speed
      = speed while running, Copy Key On Enter = set SearchCenter.'
    rect:
      serializedVersion: 2
      x: 150
      y: -260
      width: 240
      height: 140
    color: {r: 0.95, g: 0.85, b: 0.35, a: 0.95}
