      m_Text: The Old Key
    initialState: 0
    description: Journal of the world's quest.key (the state lives in World_Blackboard).
    summary:
      m_EntryId: 0
      m_Table: {fileID: 0}
      m_Text: The gate guard won't let anyone through. He lost an old key somewhere
        in the market.
    group: Main
    trackWhenActive: 1
    goal: 0
    progression:
      rid: -2
    completeAtGoal: 1
    steps:
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: Ask the gate guard how to get through
      visibleWhen: []
      doneWhen:
      - rid: 3058894632198340679
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: Find the old key (the merchant might have one)
      visibleWhen:
      - rid: 3058894632198340680
      doneWhen:
      - rid: 3058894632198340681
    - text:
        m_EntryId: 0
        m_Table: {fileID: 0}
        m_Text: Bring the key back to the gate guard
      visibleWhen:
      - rid: 3058894632198340682
      doneWhen: []
