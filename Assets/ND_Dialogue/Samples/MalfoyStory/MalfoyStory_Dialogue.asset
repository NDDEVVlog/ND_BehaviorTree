        id: 11
        title: 
        actorId: 301471443
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: Having trouble sleeping? Then perhaps I should tell you a story.
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: 
        moreLines:
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: It was somewhere in the jungles of East Asia. A quiet night,
              much like this one.
          emotion: 
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: It was a forest when I arrived. By the time I left, it was a
              runway.
          emotion: 
        isPassthrough: 0
        conditions: []
        actions: []
        links: []
        position: {x: 3000, y: 190}
