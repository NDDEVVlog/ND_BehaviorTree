      data:
        id: 7
        title: 
        actorId: 507349979
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: "A JOKE?! I've scared off every candidate for\u2014 never mind!"
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: Angry
        voice: {fileID: 0}
        localizedVoice:
          m_EntryId: 0
          m_Table: {fileID: 0}
        moreLines:
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: Fine! I'll go with you! But only out of pity for your pathetic
              look!
          emotion: Pout
          voice: {fileID: 0}
          localizedVoice:
            m_EntryId: 0
            m_Table: {fileID: 0}
        isPassthrough: 0
