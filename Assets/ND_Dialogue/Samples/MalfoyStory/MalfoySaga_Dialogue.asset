    - rid: 3058894633377727290
      type: {class: DialogueEntry, ns: ND.Dialogue, asm: ND.Dialogue}
      data:
        id: 7
        title: 
        actorId: 433743447
        text:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: I'm definitely going to Slytherin! My whole family's been in it!
        menuText:
          m_EntryId: 0
          m_Table: {fileID: 0}
          m_Text: 
        emotion: Happy
        voice: {fileID: 0}
        localizedVoice:
          m_EntryId: 0
          m_Table: {fileID: 0}
        moreLines:
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: If I end up somewhere like Hufflepuff, I'll bite my tongue off!!
          emotion: 
          voice: {fileID: 0}
          localizedVoice:
            m_EntryId: 0
            m_Table: {fileID: 0}
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: You should be in Slytherin too! Don't go mixing with the wrong
              sort! Especially...
          emotion: 
          voice: {fileID: 0}
          localizedVoice:
            m_EntryId: 0
            m_Table: {fileID: 0}
        - text:
            m_EntryId: 0
            m_Table: {fileID: 0}
            m_Text: ...What's that? He looks like a savage.
          emotion: Angry
          voice: {fileID: 0}
          localizedVoice:
            m_EntryId: 0
            m_Table: {fileID: 0}
        isPassthrough: 0
        sequence: 
        isHub: 0
        conditions: []
        actions: []
        links:
